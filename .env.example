# Notification configuration.
#
# The app writes data/notify.toml when you run `quant notify-setup`; that is the
# normal path. The variables below are an optional fallback for CI and advanced
# use, read only when data/notify.toml is absent.

# Telegram Bot API (create a bot via @BotFather, get token + chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=

# Optional: Alpha Vantage (free tier, 25 requests per day).
ALPHA_VANTAGE_API_KEY=

# Optional: email reporting.
SMTP_USER=
SMTP_PASSWORD=
REPORT_TO=
